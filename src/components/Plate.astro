---
/**
 * Abstract placeholder plate, ported from the approved direction C prototype.
 *
 * It exists so a project without an approved screenshot still has a frame.
 * Every variant is abstract geometry — never a suggestion of a real product
 * screen, a client's data or a metric.
 */
interface Props {
  variant: 'feature' | 'bars' | 'bands' | 'case';
  /** Describes what the shape is, for assistive technology. */
  label: string;
}

const { variant, label } = Astro.props;
---

{variant === 'feature' && (
  <svg viewBox="0 0 1600 900" role="img" aria-label={label}>
    <rect width="1600" height="900" fill="#081226" />
    <g stroke="#eaf1ff" stroke-opacity="0.05">
      <line x1="0" y1="180" x2="1600" y2="180" />
      <line x1="0" y1="360" x2="1600" y2="360" />
      <line x1="0" y1="540" x2="1600" y2="540" />
      <line x1="0" y1="720" x2="1600" y2="720" />
      <line x1="400" y1="0" x2="400" y2="900" />
      <line x1="800" y1="0" x2="800" y2="900" />
      <line x1="1200" y1="0" x2="1200" y2="900" />
    </g>
    <g fill="none">
      <circle cx="1180" cy="440" r="470" stroke="#2f6bff" stroke-opacity="0.22" />
      <circle cx="1180" cy="440" r="400" stroke="#2f6bff" stroke-opacity="0.3" />
      <circle cx="1180" cy="440" r="330" stroke="#2f6bff" stroke-opacity="0.42" />
      <circle cx="1180" cy="440" r="260" stroke="#2f6bff" stroke-opacity="0.56" />
      <circle cx="1180" cy="440" r="190" stroke="#2f6bff" stroke-opacity="0.72" />
      <circle cx="1180" cy="440" r="120" stroke="#5b8dff" stroke-opacity="0.85" />
    </g>
    <path d="M120 440 H760" stroke="#2fd3dd" stroke-opacity="0.55" stroke-width="2" />
    <circle cx="1180" cy="440" r="9" fill="#2fd3dd" />
    <circle cx="1180" cy="440" r="22" fill="none" stroke="#2fd3dd" stroke-opacity="0.45" />
    <g stroke="#ff6a4d" stroke-width="3">
      <line x1="120" y1="742" x2="120" y2="772" />
      <line x1="300" y1="742" x2="300" y2="762" />
      <line x1="480" y1="742" x2="480" y2="762" />
      <line x1="660" y1="742" x2="660" y2="762" />
      <line x1="840" y1="742" x2="840" y2="772" />
    </g>
  </svg>
)}

{variant === 'bars' && (
  <svg viewBox="0 0 800 600" role="img" aria-label={label}>
    <rect width="800" height="600" fill="#0a1428" />
    <g stroke="#eaf1ff" stroke-opacity="0.06">
      <line x1="80" y1="140" x2="740" y2="140" />
      <line x1="80" y1="260" x2="740" y2="260" />
      <line x1="80" y1="380" x2="740" y2="380" />
      <line x1="80" y1="500" x2="740" y2="500" />
    </g>
    <g fill="#2f6bff">
      <rect x="110" y="392" width="54" height="108" opacity="0.55" />
      <rect x="206" y="340" width="54" height="160" opacity="0.65" />
      <rect x="302" y="286" width="54" height="214" opacity="0.75" />
      <rect x="398" y="330" width="54" height="170" opacity="0.65" />
      <rect x="494" y="238" width="54" height="262" opacity="0.85" />
      <rect x="590" y="180" width="54" height="320" opacity="0.95" />
    </g>
    <path
      d="M137 372 L233 322 L329 268 L425 312 L521 220 L617 162"
      fill="none"
      stroke="#2fd3dd"
      stroke-width="3"
    />
    <circle cx="617" cy="162" r="7" fill="#2fd3dd" />
    <line x1="110" y1="500" x2="644" y2="500" stroke="#eaf1ff" stroke-opacity="0.2" />
  </svg>
)}

{variant === 'bands' && (
  <svg viewBox="0 0 800 600" role="img" aria-label={label}>
    <rect width="800" height="600" fill="#081226" />
    <g>
      <rect x="80" y="150" width="640" height="72" fill="#0c1c38" />
      <rect x="80" y="252" width="640" height="72" fill="#10233f" />
      <rect x="80" y="354" width="640" height="72" fill="#0c1c38" />
      <rect x="80" y="456" width="640" height="72" fill="#10233f" />
    </g>
    <g fill="#2fd3dd">
      <rect x="120" y="178" width="10" height="16" />
      <rect x="210" y="178" width="10" height="16" />
      <rect x="300" y="178" width="10" height="16" />
      <rect x="150" y="280" width="10" height="16" />
      <rect x="330" y="280" width="10" height="16" />
      <rect x="470" y="280" width="10" height="16" />
      <rect x="250" y="382" width="10" height="16" />
      <rect x="560" y="382" width="10" height="16" />
      <rect x="390" y="484" width="10" height="16" />
    </g>
    <path
      d="M110 500 L250 420 L390 450 L530 300 L690 210"
      fill="none"
      stroke="#2f6bff"
      stroke-width="4"
    />
    <circle cx="690" cy="210" r="8" fill="#ff6a4d" />
  </svg>
)}

{variant === 'case' && (
  <svg viewBox="0 0 1600 780" role="img" aria-label={label}>
    <rect width="1600" height="780" fill="#081226" />
    <g stroke="#eaf1ff" stroke-opacity="0.05">
      <line x1="0" y1="195" x2="1600" y2="195" />
      <line x1="0" y1="390" x2="1600" y2="390" />
      <line x1="0" y1="585" x2="1600" y2="585" />
      <line x1="400" y1="0" x2="400" y2="780" />
      <line x1="800" y1="0" x2="800" y2="780" />
      <line x1="1200" y1="0" x2="1200" y2="780" />
    </g>
    <g fill="none" stroke-linecap="round">
      <path
        d="M980 60 A 400 400 0 0 1 1460 420"
        stroke="#2f6bff"
        stroke-opacity="0.5"
        stroke-width="2"
      />
      <path
        d="M900 140 A 320 320 0 0 1 1300 420"
        stroke="#2f6bff"
        stroke-opacity="0.65"
        stroke-width="2"
      />
      <path
        d="M820 220 A 240 240 0 0 1 1140 420"
        stroke="#5b8dff"
        stroke-opacity="0.8"
        stroke-width="2"
      />
    </g>
    <circle cx="1460" cy="420" r="8" fill="#2fd3dd" />
    <g stroke="#ff6a4d" stroke-width="3">
      <line x1="140" y1="600" x2="140" y2="628" />
      <line x1="470" y1="600" x2="470" y2="618" />
      <line x1="800" y1="600" x2="800" y2="618" />
      <line x1="1130" y1="600" x2="1130" y2="618" />
      <line x1="1460" y1="600" x2="1460" y2="628" />
    </g>
  </svg>
)}
