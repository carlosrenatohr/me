---
/**
 * The featured project block: wide plate, title, summary, metadata and the
 * case-study link. Used by the home page and the projects index.
 */
import Plate from '@/components/Plate.astro';
import { projectPath } from '@/config/site';
import type { PublicProject } from '@/lib/content';

interface Props {
  project: PublicProject;
  /** Set on the first feature above the fold so the plate loads eagerly. */
  priority?: boolean;
  showBadge?: boolean;
}

const { project, priority = false, showBadge = true } = Astro.props;
const { data } = project;
const pending = '[to confirm]';
---

<article class="feature">
  <a
    class="feature-media"
    href={projectPath(project.slug)}
    aria-label={`Read the ${data.title} case study`}
  >
    {data.cover ? (
      <img
        src={data.cover.src}
        alt={data.cover.alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
    ) : (
      <Plate variant="feature" label="Abstract placeholder plate: concentric blue arcs" />
    )}
    {!data.cover && <span class="media-note">Image placeholder</span>}
  </a>

  <div class="feature-body">
    <div class="feature-title">
      {showBadge && (
        <p class="badge">
          <span class="dot" aria-hidden="true" />
          Selected project
        </p>
      )}
      <p class="eyebrow">{data.category}</p>
      <h3>
        <a href={projectPath(project.slug)}>{data.title}</a>
      </h3>
    </div>

    <p class="feature-summary">{data.summary}</p>

    <dl class="project-meta">
      <div>
        <dt>Role</dt>
        <dd>{data.role ?? pending}</dd>
      </div>
      <div>
        <dt>Period</dt>
        <dd>{data.period?.start ?? pending}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>{data.technologies.length ? data.technologies.join(', ') : pending}</dd>
      </div>
    </dl>

    <a class="text-link" href={projectPath(project.slug)}>
      Read the case study <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
