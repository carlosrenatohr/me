---
/**
 * The featured project block: wide plate, title, summary, metadata and the
 * case-study link. Used by the home page and the projects index.
 */
import { projectPath } from '@/config/site';
import { publicAsset } from '@/config/assets';
import { isSampleProject, type PublicProject } from '@/lib/content';

interface Props {
  project: PublicProject;
  /** Set on the first feature above the fold so the plate loads eagerly. */
  priority?: boolean;
  showBadge?: boolean;
}

const { project, priority = false, showBadge = true } = Astro.props;
const { data } = project;
const sample = isSampleProject(project);
---

<article class:list={['feature', !data.cover && 'feature-plain']}>
  {data.cover && (
    <a
      class="feature-media"
      href={projectPath(project.slug)}
      aria-label={`Read the ${data.title} case study`}
    >
      <img
        src={publicAsset(data.cover.src)}
        alt={data.cover.alt}
        width="1600"
        height="900"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
      {sample && <span class="media-note">Sample mockup — not a product screenshot</span>}
    </a>
  )}

  <div class="feature-body">
    <div class="feature-title">
      {sample ? (
        <p class="badge sample-flag">
          <span class="dot" aria-hidden="true" />
          Sample case study
        </p>
      ) : (
        showBadge && (
          <p class="badge">
            <span class="dot" aria-hidden="true" />
            {data.collection === 'featured' ? 'Featured product' : 'Selected project'}
          </p>
        )
      )}
      <p class="eyebrow">{data.category}</p>
      <h3>
        <a href={projectPath(project.slug)}>{data.title}</a>
      </h3>
    </div>

    <p class="feature-summary">{data.summary}</p>

    <dl class="project-meta">
      {data.role && (
        <div>
          <dt>Role</dt>
          <dd>{data.role}</dd>
        </div>
      )}
      {data.period && (
        <div>
          <dt>Period</dt>
          <dd>{data.period.start}</dd>
        </div>
      )}
      {data.technologies.length > 0 && (
        <div>
          <dt>Stack</dt>
          <dd>{data.technologies.join(', ')}</dd>
        </div>
      )}
    </dl>

    <a class="text-link" href={projectPath(project.slug)}>
      Read the case study <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
