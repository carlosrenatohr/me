---
/**
 * Location pin for a place name.
 *
 * Decorative: the place is always written next to it, so the icon is hidden
 * from assistive technology and inherits the colour of its line.
 */
---

<svg
  class="pin"
  viewBox="0 0 24 24"
  width="12"
  height="12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11Z"></path>
  <circle cx="12" cy="10" r="2.5"></circle>
</svg>
