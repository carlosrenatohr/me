---
// Contact — direct channels only. No form, so nothing can silently fail.
import BaseLayout from '@/layouts/BaseLayout.astro';
import LocationPin from '@/components/LocationPin.astro';
import { getContactDetails } from '@/lib/contact';
import { getProfile } from '@/lib/content';
import { ROUTES, SITE } from '@/config/site';
import { publicAsset } from '@/config/assets';

const contact = await getContactDetails();
const profile = await getProfile();
const availability =
  profile.data.contentStatus === 'verified' ? profile.data.availability : undefined;

const externalLinks = contact.links.filter((link) => link.external);

const description =
  'Contact Carlos Renato: email, professional profiles and CV. No forms, only direct channels that reach a person.';
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description={description}
  path={ROUTES.contact}
  current="contact"
>
  <section class="hero" aria-labelledby="contact-title">
    <div class="hero-grid">
      {availability && (
        <p class="status">
          <span class="status-dot" aria-hidden="true" />
          {availability}
        </p>
      )}

      <h1 id="contact-title">
        Tell me what <br /> you are building.
      </h1>

      <p class="hero-lede">
        I am open to new projects, and to teams that need someone to own a problem from the data
        model to the interface. Email is the fastest route: it reaches me, not a shared inbox.
      </p>

      <div class="contact-hero-actions">
        {contact.email && (
          <a class="mail-link" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        )}

        <ul class="contact-links">
          {externalLinks.map((link) => (
            <li>
              <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
          {contact.cvPath && (
            <li>
              <a class="text-link" href={contact.cvPath} download>
                CV (PDF) <span aria-hidden="true">↓</span>
              </a>
            </li>
          )}
        </ul>
      </div>

      <dl class="hero-meta">
        <div>
          <dt>Working from</dt>
          <dd>
            {contact.location ? (
              <span class="meta-location">
                <LocationPin />
                {contact.location}
              </span>
            ) : (
              <span class="is-pending">[location to confirm]</span>
            )}
          </dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>
            {contact.phone ? (
              <a href={contact.phoneHref}>{contact.phone}</a>
            ) : (
              <span class="is-pending">[phone to confirm]</span>
            )}
          </dd>
        </div>
        <div>
          <dt>Availability</dt>
          <dd>{availability ?? <span class="is-pending">[availability to confirm]</span>}</dd>
        </div>
        <div>
          <dt>CV</dt>
          <dd>
            {contact.cvPath ? (
              'Two pages, PDF'
            ) : (
              <span class="is-pending">[CV to be supplied]</span>
            )}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cv-band" aria-labelledby="cv-title">
    <div class="cv-row">
      <div>
        <p class="contact-label" id="cv-title">
          CV
        </p>
        {contact.cvPath ? (
          <div class="cv-actions">
            <a class="text-link" href={contact.cvPath} target="_blank" rel="noopener">
              Open in a new tab <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href={contact.cvPath} download>
              Download (PDF) <span aria-hidden="true">↓</span>
            </a>
          </div>
        ) : (
          <p class="contact-value is-pending">[CV to be supplied]</p>
        )}
      </div>
      <p class="cv-note">
        The pages below are a preview linked to the PDF. No embed library, no third-party frame, no
        tracking: a current, owner-approved document is the only thing published here.
      </p>
    </div>

    {contact.cvPath && (
      <div class="cv-pages">
        {[
          {
            file: 'cv-1.webp',
            label: 'Page 1 of 2',
            alt: 'CV page 1: summary, technical skills and current roles',
          },
          {
            file: 'cv-2.webp',
            label: 'Page 2 of 2',
            alt: 'CV page 2: earlier roles, AI automation work and education',
          },
        ].map((page) => (
          <a class="cv-page" href={contact.cvPath} target="_blank" rel="noopener">
            <img
              src={publicAsset(`images/cv/${page.file}`)}
              alt={page.alt}
              width="1347"
              height="1743"
              loading="lazy"
            />
            <span class="cv-page-label">{page.label}</span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
