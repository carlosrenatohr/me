---
// Contact — direct channels only. No form, so nothing can silently fail.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContactDetails } from '@/lib/contact';
import { ROUTES, SITE } from '@/config/site';

const contact = await getContactDetails();
const hasLinks = contact.links.length > 0;

// The section rule carries the state of the record, not a repeated value:
// visitors should see at a glance how much of this page is already confirmed.
const confirmedChannels = [
  contact.email,
  contact.location,
  hasLinks ? 'links' : '',
  contact.cvPath,
].filter(Boolean).length;
const channelsMeta =
  confirmedChannels === 0 ? 'Nothing confirmed yet' : `${confirmedChannels} of 4 confirmed`;

const description =
  'Contact Carlos Renato: email and professional profiles. No forms, only direct channels that reach a person.';
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description={description}
  path={ROUTES.contact}
  current="contact"
>
  <section class="hero" aria-labelledby="contact-title">
    <div class="hero-grid">
      <h1 id="contact-title">Contact</h1>
      <p class="hero-lede">
        Direct channels only. Email is the fastest route; the profiles below are the rest of the
        trail.
      </p>
    </div>
  </section>

  <section class="work" aria-labelledby="channels-title">
    <div class="section-rule">
      <h2 id="channels-title">Channels</h2>
      <p>{channelsMeta}</p>
    </div>

    <div class="contact-grid">
      <div class="contact-card">
        <p class="contact-label">Email</p>
        {contact.email ? (
          <a class="contact-value" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        ) : (
          <p class="contact-value is-pending">[email to confirm]</p>
        )}
      </div>

      <div class="contact-card">
        <p class="contact-label">Working from</p>
        {contact.location ? (
          <p class="contact-value">{contact.location}</p>
        ) : (
          <p class="contact-value is-pending">[location to confirm]</p>
        )}
      </div>

      <div class="contact-card">
        <p class="contact-label">Profiles</p>
        {hasLinks ? (
          <ul class="contact-links">
            {contact.links.map((link) => (
              <li>
                <a
                  class="text-link"
                  href={link.url}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="contact-value is-pending">[professional links to confirm]</p>
        )}
      </div>
    </div>
  </section>

  <section class="cv-band" aria-labelledby="cv-title">
    <div class="cv-row">
      <div>
        <p class="contact-label" id="cv-title">
          CV
        </p>
        {contact.cvPath ? (
          <a class="text-link" href={contact.cvPath}>
            Download CV (PDF) <span aria-hidden="true">↓</span>
          </a>
        ) : (
          <p class="contact-value is-pending">[CV to be supplied]</p>
        )}
      </div>
      <p class="cv-note">
        Only a current, owner-approved document is published here. No form, no tracking, no captured
        address.
      </p>
    </div>
  </section>
</BaseLayout>
