---
// Contact — direct channels only. No form, so nothing can silently fail.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContactDetails } from '@/lib/contact';
import { ROUTES, SITE } from '@/config/site';
import { publicAsset } from '@/config/assets';

const contact = await getContactDetails();
const hasLinks = contact.links.length > 0;

// The section rule carries the state of the record, not a repeated value:
// visitors should see at a glance how much of this page is already confirmed.
const confirmedChannels = [
  contact.email,
  contact.phone,
  contact.location,
  hasLinks ? 'links' : '',
  contact.cvPath,
].filter(Boolean).length;
const channelsMeta =
  confirmedChannels === 0 ? 'Nothing confirmed yet' : `${confirmedChannels} of 5 confirmed`;

const description =
  'Contact Carlos Renato: email and professional profiles. No forms, only direct channels that reach a person.';
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description={description}
  path={ROUTES.contact}
  current="contact"
>
  <section class="hero" aria-labelledby="contact-title">
    <div class="hero-grid">
      <h1 id="contact-title">Contact</h1>
      <p class="hero-lede">
        Direct channels only. Email is the fastest route; the profiles below are the rest of the
        trail.
      </p>
    </div>
  </section>

  <section class="work" aria-labelledby="channels-title">
    <div class="section-rule">
      <h2 id="channels-title">Channels</h2>
      <p>{channelsMeta}</p>
    </div>

    <div class="contact-grid">
      <div class="contact-card">
        <p class="contact-label">Email</p>
        {contact.email ? (
          <a class="contact-value" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        ) : (
          <p class="contact-value is-pending">[email to confirm]</p>
        )}
      </div>

      <div class="contact-card">
        <p class="contact-label">Phone</p>
        {contact.phone ? (
          <a class="contact-value" href={contact.phoneHref}>
            {contact.phone}
          </a>
        ) : (
          <p class="contact-value is-pending">[phone to confirm]</p>
        )}
      </div>

      <div class="contact-card">
        <p class="contact-label">Working from</p>
        {contact.location ? (
          <p class="contact-value">{contact.location}</p>
        ) : (
          <p class="contact-value is-pending">[location to confirm]</p>
        )}
      </div>

      <div class="contact-card">
        <p class="contact-label">Profiles</p>
        {hasLinks ? (
          <ul class="contact-links">
            {contact.links.map((link) => (
              <li>
                <a
                  class="text-link"
                  href={link.url}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="contact-value is-pending">[professional links to confirm]</p>
        )}
      </div>
    </div>
  </section>

  <section class="cv-band" aria-labelledby="cv-title">
    <div class="cv-row">
      <div>
        <p class="contact-label" id="cv-title">
          CV
        </p>
        {contact.cvPath ? (
          <div class="cv-actions">
            <a class="text-link" href={contact.cvPath} target="_blank" rel="noopener">
              Open in a new tab <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href={contact.cvPath} download>
              Download (PDF) <span aria-hidden="true">↓</span>
            </a>
          </div>
        ) : (
          <p class="contact-value is-pending">[CV to be supplied]</p>
        )}
      </div>
      <p class="cv-note">
        The pages below are a preview linked to the PDF. No embed library, no third-party frame, no
        tracking: a current, owner-approved document is the only thing published here.
      </p>
    </div>

    {contact.cvPath && (
      <div class="cv-pages">
        {[
          {
            file: 'cv-1.webp',
            label: 'Page 1 of 2',
            alt: 'CV page 1: summary, technical skills and current roles',
          },
          {
            file: 'cv-2.webp',
            label: 'Page 2 of 2',
            alt: 'CV page 2: earlier roles, AI automation work and education',
          },
        ].map((page) => (
          <a class="cv-page" href={contact.cvPath} target="_blank" rel="noopener">
            <img
              src={publicAsset(`images/cv/${page.file}`)}
              alt={page.alt}
              width="1347"
              height="1743"
              loading="lazy"
            />
            <span class="cv-page-label">{page.label}</span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
