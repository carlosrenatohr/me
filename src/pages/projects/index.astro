---
// Projects index — personal and side projects first, client work after.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import ProjectPair from '@/components/ProjectPair.astro';
import { getPublishedProjects } from '@/lib/content';
import { ROUTES, SITE } from '@/config/site';

const projects = await getPublishedProjects();
const personal = projects.filter((project) => project.data.kind === 'personal');
const client = projects.filter((project) => project.data.kind === 'client');
const bothKinds = personal.length > 0 && client.length > 0;

const countLabel = projects.length === 1 ? '1 project' : `${projects.length} projects`;
const description =
  'Products built and shipped, personal and client work: the problem, the role, the decisions and the verified outcomes.';
---

<BaseLayout
  title={`Work — ${SITE.name}`}
  description={description}
  path={ROUTES.projects}
  current="projects"
>
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-grid">
      <h1 id="page-title">Selected work</h1>
      <p class="hero-lede">
        Each case study states the problem, what I personally owned, the decisions behind it, and
        what changed. Nothing is published before it is verified.
      </p>
    </div>
  </section>

  {projects.length === 0 && (
    <section class="work" aria-labelledby="work-title">
      <div class="section-rule">
        <h2 id="work-title">Projects</h2>
        <p>{countLabel}</p>
      </div>

      <div class="empty">
        <p class="empty-body">
          No published projects yet. Case studies appear here once the owner confirms the role,
          dates, contribution and outcomes for each one.
        </p>
        <p class="empty-note">
          [Content pending — verified entries go in <code>src/content/projects/</code> with
          <code>status: published</code> and <code>contentStatus: verified</code>.]
        </p>
      </div>
    </section>
  )}

  {personal.length > 0 && (
    <section class="work" aria-labelledby="personal-title">
      <div class="section-rule">
        <h2 id="personal-title">{bothKinds ? 'Personal & side projects' : 'Projects'}</h2>
        <p>{personal.length === 1 ? '1 project' : `${personal.length} projects`}</p>
      </div>

      <ProjectFeature project={personal[0]} priority showBadge={false} />
      <ProjectPair projects={personal.slice(1)} />
    </section>
  )}

  {client.length > 0 && (
    <section class="work" aria-labelledby="client-title">
      <div class="section-rule">
        <h2 id="client-title">{bothKinds ? 'Client & product work' : 'Projects'}</h2>
        <p>{client.length === 1 ? '1 project' : `${client.length} projects`}</p>
      </div>

      <ProjectFeature project={client[0]} showBadge={false} />
      <ProjectPair projects={client.slice(1)} />
    </section>
  )}
</BaseLayout>
