---
// Projects index — a list of entries that open into full case studies.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectIndexItem from '@/components/ProjectIndexItem.astro';
import { getPublishedProjects, isSampleProject } from '@/lib/content';
import { collectionPageNode } from '@/lib/seo';
import { ROUTES, SITE } from '@/config/site';

const projects = await getPublishedProjects();
const hasSamples = projects.some(isSampleProject);

// Samples exist to prove the layout, not to be found in a search result. Until at
// least one real case study is published, this index is a placeholder page and is
// kept out of the index; it becomes indexable by itself once real work lands.
const hasRealProjects = projects.some((project) => project.data.status === 'published');

const countLabel = projects.length === 1 ? '1 project' : `${projects.length} projects`;
const description =
  'Case studies from backend and integration work: the problem, the role, the architecture decisions and the verified outcomes.';
---

<BaseLayout
  title={`Projects — ${SITE.name}, Senior Software Engineer`}
  description={description}
  path={ROUTES.projects}
  current="projects"
  noindex={!hasRealProjects}
  schema={[collectionPageNode(projects)]}
>
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-grid">
      <h1 id="page-title">
        Projects, <em>in detail.</em>
      </h1>
      <p class="hero-lede">
        One structure for every entry: the problem, the solution, what I personally owned, the AI
        role where there is one, the decisions behind it, and what changed.
      </p>
    </div>
  </section>

  {hasSamples && (
    <p class="sample-notice">
      <strong>Sample content</strong>
      These entries demonstrate the case study format. The layout, metadata and media pipeline are
      real; the projects are not, and no live URL is published for any of them.
    </p>
  )}

  <section class="work" aria-labelledby="projects-title">
    <div class="section-rule">
      <h2 id="projects-title">All projects</h2>
      <p>{countLabel}</p>
    </div>

    {projects.length === 0 ? (
      <div class="empty">
        <p class="empty-body">
          No published projects yet. Case studies appear here once the owner confirms the role,
          dates, contribution and outcomes for each one.
        </p>
        <p class="empty-note">
          [Content pending — verified entries go in <code>src/content/projects/</code> with
          <code>status: published</code> and <code>contentStatus: verified</code>.]
        </p>
      </div>
    ) : (
      <div class="index-list">
        {projects.map((project, index) => (
          <ProjectIndexItem project={project} index={index + 1} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
