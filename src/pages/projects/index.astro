---
// Projects index — three shelves in the owner's order: featured products,
// open-source experiments, then professional case studies.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectAccordion from '@/components/ProjectAccordion.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import ProjectIndexItem from '@/components/ProjectIndexItem.astro';
import ProjectPair from '@/components/ProjectPair.astro';
import { getDraftProjects, getPublishedProjects, getProjectGroups } from '@/lib/content';
import { collectionPageNode } from '@/lib/seo';
import { ROUTES, SITE } from '@/config/site';

const projects = await getPublishedProjects();
const { featured, openSource, professional } = await getProjectGroups();
const drafts = await getDraftProjects();

const leadProduct = featured[0];
const otherProducts = featured.slice(1);

const description =
  'Product case studies and engineering work: logistics platforms, an AI review workflow, open-source experiments and backend work on marketing analytics and enterprise platforms.';
---

<BaseLayout
  title={`Projects — ${SITE.name}, Product Engineer`}
  description={description}
  path={ROUTES.projects}
  current="projects"
  schema={[collectionPageNode(projects)]}
>
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-grid">
      <h1 id="page-title">
        Projects, <em>in detail.</em>
      </h1>
      <p class="hero-lede">
        Products I build and operate first, experiments second, and the professional engineering
        work that supports both. Every entry states the problem, what I personally owned, the
        decisions behind it and what the evidence actually shows.
      </p>
    </div>
  </section>

  <section class="work" aria-labelledby="featured-title">
    <div class="section-rule">
      <h2 id="featured-title">Featured products</h2>
      <p>{featured.length} products</p>
    </div>

    {leadProduct ? (
      <ProjectFeature project={leadProduct} priority showBadge={false} />
    ) : (
      <div class="empty">
        <p class="empty-body">No product has been published yet.</p>
      </div>
    )}

    <ProjectPair projects={otherProducts} />
  </section>

  {openSource.length + drafts.length > 0 && (
    <section class="work" aria-label="More work and open source">
      <ProjectAccordion projects={openSource} drafts={drafts} />
    </section>
  )}

  {professional.length > 0 && (
    <section class="work" aria-labelledby="professional-title">
      <div class="section-rule">
        <h2 id="professional-title">Professional case studies</h2>
        <p>{professional.length} engagements</p>
      </div>

      <p class="section-note">
        Work delivered as part of an employer or team. Platform-level figures are labelled as such;
        client identities and employer source code stay private.
      </p>

      <div class="index-list">
        {professional.map((project, index) => (
          <ProjectIndexItem project={project} index={index + 1} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
