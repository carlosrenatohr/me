---
// Project case study — direction C document layout.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Plate from '@/components/Plate.astro';
import { getPublishedProjects, type PublicProject } from '@/lib/content';
import { projectPath, ROUTES, SITE } from '@/config/site';

interface Props {
  project: PublicProject;
}

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const projects = await getPublishedProjects();
const index = projects.findIndex((entry) => entry.slug === project.slug);
const next = projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;

const pending = '[to confirm]';

/** Frontmatter strings keep their paragraph breaks; render them as paragraphs. */
function paragraphs(value?: string): string[] {
  if (!value) return [];
  return value
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

const sections = [
  { id: 'context', label: 'Context' },
  { id: 'contribution', label: 'Contribution' },
  { id: 'approach', label: 'Approach' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'outcomes', label: 'Outcomes' },
];

const period = data.period
  ? `${data.period.start}${data.period.end ? ` — ${data.period.end}` : ''}`
  : pending;
---

<BaseLayout
  title={`${data.title} — ${SITE.name}`}
  description={data.summary}
  path={projectPath(project.slug)}
  current="projects"
  ogType="article"
>
  <article class="case">
    <header class="case-head">
      <a class="back" href={ROUTES.projects}>
        All work
      </a>
      <p class="eyebrow">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="case-lede">{data.summary}</p>

      <dl class="spec">
        <div>
          <dt>Role</dt>
          <dd>{data.role ?? pending}</dd>
        </div>
        <div>
          <dt>Period</dt>
          <dd>{period}</dd>
        </div>
        <div>
          <dt>Surface</dt>
          <dd>{data.surfaces.length ? data.surfaces.join(', ') : pending}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{data.technologies.length ? data.technologies.join(', ') : pending}</dd>
        </div>
      </dl>
    </header>

    <figure class="case-figure">
      {data.cover ? (
        <img src={data.cover.src} alt={data.cover.alt} fetchpriority="high" />
      ) : (
        <Plate
          variant="case"
          label="Abstract placeholder plate: broken blue arcs over a coral baseline"
        />
      )}
      <figcaption>
        {data.cover ? data.cover.alt : 'Product image placeholder — approved screenshot pending.'}
      </figcaption>
    </figure>

    <div class="doc">
      <nav class="toc" aria-label="Contents">
        <p class="toc-label">Contents</p>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="doc-body">
        <section class="doc-section" id="context">
          <h2>Context</h2>
          {paragraphs(data.context).length ? (
            paragraphs(data.context).map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <p class="placeholder">
              [Context placeholder — the problem, the people affected and the operating environment,
              in verified terms.]
            </p>
          )}
        </section>

        <section class="doc-section" id="contribution">
          <h2>Contribution</h2>
          {paragraphs(data.contribution).length ? (
            paragraphs(data.contribution).map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <p class="placeholder">
              [Contribution placeholder — only what I personally designed, built and decided, with
              the boundaries of that scope stated plainly.]
            </p>
          )}
        </section>

        {data.quote && (
          <blockquote class="quote">
            <p>{data.quote}</p>
          </blockquote>
        )}

        <section class="doc-section" id="approach">
          <h2>Approach</h2>
          {paragraphs(data.approach).length ? (
            paragraphs(data.approach).map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <p class="placeholder">
              [Approach placeholder — the sequence of decisions, what was traded away and why the
              simpler option was not enough.]
            </p>
          )}
        </section>

        <section class="doc-section" id="decisions">
          <h2>Decisions</h2>
          {data.technicalDecisions.length ? (
            <ol class="decision-list">
              {data.technicalDecisions.map((decision, decisionIndex) => (
                <li>
                  <span>D{decisionIndex + 1}</span>
                  <div>
                    <h3>{decision.title}</h3>
                    <p>{decision.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="placeholder">
              [Decisions placeholder — list the substantive choices, what each one solved and what
              it cost.]
            </p>
          )}
        </section>

        <section class="doc-section" id="outcomes">
          <h2>Outcomes</h2>
          {data.outcomes.length ? (
            <ul class="outcome-list">
              {data.outcomes.map((outcome, outcomeIndex) => (
                <li>
                  <span>O{outcomeIndex + 1}</span>
                  <p>{outcome}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="placeholder">
              [Outcomes placeholder — verified results or lessons only. No adoption numbers, client
              names or metrics before the owner confirms them.]
            </p>
          )}

          {data.confidentialityNote && <p class="confidential">{data.confidentialityNote}</p>}
        </section>

        {data.screenshots.length > 0 && (
          <section class="doc-section" aria-labelledby="screens-title">
            <h2 id="screens-title">Screens</h2>
            <div class="case-gallery">
              {data.screenshots.map((image) => (
                <figure>
                  <img src={image.src} alt={image.alt} loading="lazy" />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}

        {data.links.length > 0 && (
          <section class="doc-section" aria-labelledby="links-title">
            <h2 id="links-title">Links</h2>
            <ul class="case-links">
              {data.links.map((link) => (
                <li>
                  <a
                    class="text-link"
                    href={link.url}
                    target={/^https?:/i.test(link.url) ? '_blank' : undefined}
                    rel={/^https?:/i.test(link.url) ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    {next && (
      <nav class="next-project" aria-label="Next project">
        <p class="eyebrow">Next project — {next.data.category}</p>
        <a href={projectPath(next.slug)}>
          {next.data.title} <span aria-hidden="true">→</span>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>
