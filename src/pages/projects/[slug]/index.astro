---
// Project case study — direction C document layout, built around the questions a
// reader brings: what was wrong, what answers it, what did I own, where does AI
// sit, what is it built on, and what changed.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Plate from '@/components/Plate.astro';
import { getPublishedProjects, isSampleProject, type PublicProject } from '@/lib/content';
import { breadcrumbNode, clampDescription, creativeWorkNode } from '@/lib/seo';
import { projectPath, ROUTES, SITE } from '@/config/site';
import { publicAsset } from '@/config/assets';

interface Props {
  project: PublicProject;
}

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const sample = isSampleProject(project);

const projects = await getPublishedProjects();
const index = projects.findIndex((entry) => entry.slug === project.slug);
const next = projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;

const pending = '[to confirm]';

const period = data.period
  ? `${data.period.start}${data.period.end ? ` — ${data.period.end}` : ''}`
  : pending;

/** Frontmatter strings keep their paragraph breaks; render them as paragraphs. */
function paragraphs(value?: string): string[] {
  if (!value) return [];
  return value
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

const stack: Array<{ label: string; items: string[] }> = data.stackGroups.length
  ? data.stackGroups
  : data.technologies.length
    ? [{ label: 'Stack', items: data.technologies }]
    : [];

// The contents rail lists only what the page actually states: a section that
// has nothing to show is not advertised.
const sections = [
  { id: 'problem', label: 'Problem', present: true },
  { id: 'solution', label: 'Solution', present: data.solution.length > 0 },
  { id: 'contribution', label: 'Contribution', present: Boolean(data.contribution) },
  { id: 'approach', label: 'Approach', present: Boolean(data.approach) },
  { id: 'ai', label: 'AI role', present: Boolean(data.aiRole) },
  { id: 'decisions', label: 'Decisions', present: data.technicalDecisions.length > 0 },
  { id: 'stack', label: 'Stack', present: stack.length > 0 },
  { id: 'impact', label: 'Impact', present: data.outcomes.length > 0 },
  { id: 'screens', label: 'Screens', present: data.screenshots.length > 0 },
  { id: 'links', label: 'Links', present: data.links.length > 0 },
].filter((section) => section.present);
---

<!--
  A sample is a demonstration of the format, not the owner's work. Its page stays
  reachable for review but must never be indexed as a delivered project, so it is
  noindex and carries no case-study schema.
-->
<BaseLayout
  title={`${data.title} — ${data.category} case study | ${SITE.name}`}
  description={clampDescription(data.summary)}
  path={projectPath(project.slug)}
  current="projects"
  ogType="article"
  noindex={sample}
  schema={sample ? [] : [creativeWorkNode(project), breadcrumbNode(project)]}
>
  <article class="case">
    {sample && (
      <p class="sample-banner">
        <strong>Sample case study</strong>A fictional project written to demonstrate the format. The
        layout, structure and media pipeline are real; the work is not.
      </p>
    )}

    <header class="case-head">
      <a class="back" href={ROUTES.projects}>
        All work
      </a>
      <p class="eyebrow">
        {data.category}
        <span class="eyebrow-sep" aria-hidden="true">
          ·
        </span>
        {data.kind === 'personal' ? 'Personal' : 'Client work'}
      </p>
      <h1>{data.title}</h1>
      <p class="case-lede">{data.summary}</p>

      <dl class="spec">
        <div>
          <dt>Role</dt>
          <dd>{data.role ?? pending}</dd>
        </div>
        <div>
          <dt>Period</dt>
          <dd>{period}</dd>
        </div>
        <div>
          <dt>Surface</dt>
          <dd>{data.surfaces.length ? data.surfaces.join(', ') : pending}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{data.technologies.length ? data.technologies.join(', ') : pending}</dd>
        </div>
      </dl>
    </header>

    <figure class="case-figure">
      {data.cover ? (
        <img
          src={publicAsset(data.cover.src)}
          alt={data.cover.alt}
          width="1600"
          height="900"
          fetchpriority="high"
        />
      ) : (
        <Plate
          variant="case"
          label="Abstract placeholder plate: broken blue arcs over a coral baseline"
        />
      )}
      <figcaption>
        {data.cover ? data.cover.alt : 'Product image placeholder — approved screenshot pending.'}
      </figcaption>
    </figure>

    <div class="doc">
      <nav class="toc" aria-label="Contents">
        <p class="toc-label">Contents</p>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="doc-body">
        <section class="doc-section" id="problem">
          <h2>The problem</h2>
          {paragraphs(data.context).length ? (
            paragraphs(data.context).map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <p class="placeholder">
              [Problem placeholder — the situation, the people affected and what it cost, in
              verified terms.]
            </p>
          )}
        </section>

        {data.solution.length > 0 && (
          <section class="doc-section" id="solution">
            <h2>Solution</h2>
            <ol class="solution-list">
              {data.solution.map((item, itemIndex) => (
                <li>
                  <span aria-hidden="true">{String(itemIndex + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {data.quote && (
          <blockquote class="quote">
            <p>{data.quote}</p>
          </blockquote>
        )}

        {data.contribution && (
          <section class="doc-section" id="contribution">
            <h2>Contribution</h2>
            {paragraphs(data.contribution).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )}

        {data.approach && (
          <section class="doc-section" id="approach">
            <h2>Approach</h2>
            {paragraphs(data.approach).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )}

        {data.aiRole && (
          <section class="doc-section" id="ai">
            <h2>AI role</h2>
            {paragraphs(data.aiRole).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <p class="section-note">
              <a class="text-link" href={ROUTES.ai}>
                How I work with AI <span aria-hidden="true">→</span>
              </a>
            </p>
          </section>
        )}

        {data.technicalDecisions.length > 0 && (
          <section class="doc-section" id="decisions">
            <h2>Decisions</h2>
            <ol class="decision-list">
              {data.technicalDecisions.map((decision, decisionIndex) => (
                <li>
                  <span>D{decisionIndex + 1}</span>
                  <div>
                    <h3>{decision.title}</h3>
                    <p>{decision.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {stack.length > 0 && (
          <section class="doc-section" id="stack">
            <h2>Stack</h2>
            <div class="stack-groups">
              {stack.map((group) => (
                <div class="stack-group">
                  <h3>{group.label}</h3>
                  <ul class="chip-row">
                    {group.items.map((item) => (
                      <li class="chip">{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <p class="section-note">
              <a class="text-link" href={ROUTES.skills}>
                See the full stack, layer by layer <span aria-hidden="true">→</span>
              </a>
            </p>
          </section>
        )}

        {data.outcomes.length > 0 && (
          <section class="doc-section" id="impact">
            <h2>Impact</h2>
            <ul class="outcome-list">
              {data.outcomes.map((outcome, outcomeIndex) => (
                <li>
                  <span>O{outcomeIndex + 1}</span>
                  <p>{outcome}</p>
                </li>
              ))}
            </ul>
            {data.confidentialityNote && <p class="confidential">{data.confidentialityNote}</p>}
          </section>
        )}

        {data.screenshots.length > 0 && (
          <section class="doc-section" id="screens">
            <h2>Screens</h2>
            <div class="case-gallery">
              {data.screenshots.map((image) => (
                <figure>
                  <img
                    src={publicAsset(image.src)}
                    alt={image.alt}
                    width="1600"
                    height="900"
                    loading="lazy"
                  />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}

        {data.links.length > 0 && (
          <section class="doc-section" id="links">
            <h2>Links</h2>
            <ul class="case-links">
              {data.links.map((link) => (
                <li>
                  <a
                    class="text-link"
                    href={link.url}
                    target={/^https?:/i.test(link.url) ? '_blank' : undefined}
                    rel={/^https?:/i.test(link.url) ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    {next && (
      <nav class="next-project" aria-label="Next project">
        <p class="eyebrow">Next project — {next.data.category}</p>
        <a href={projectPath(next.slug)}>
          {next.data.title} <span aria-hidden="true">→</span>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>
