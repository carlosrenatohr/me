---
// Phase 03 — About and experience.
import type { Experience } from '../lib/content';
import { getExperience } from '../lib/content';
import '../styles/base.css';
import '../styles/primitives.css';
import { SITE } from '../config/site';

const experiences = await getExperience();
const hasExperience = experiences.length > 0;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} — About</title>
    <meta name="description" content={SITE.description} />
    <link rel="canonical" href={new URL('/about', SITE.origin).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={SITE.defaultTitle} />
    <meta property="og:description" content={SITE.description} />
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:title" content={SITE.defaultTitle} />
    <meta property="twitter:description" content={SITE.description} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>

    <header class="site-head">
      <a class="wordmark" href="/">
        Carlos Renato
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/projects">Projects</a>
        <a href="/about" aria-current="page">
          About
        </a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="about-title">
        <h1 id="about-title">About</h1>
        <p class="lede">
          {hasExperience
            ? `A portfolio of ${experiences.length} verified roles, ordered newest first.`
            : 'No verified experience yet. Biography and employment details are placeholders pending owner confirmation.'}
        </p>
        <p class="meta-note">
          {hasExperience
            ? 'Read the work, then get in touch.'
            : '[Placeholder — biography to be written from verified facts.]'}
        </p>
      </section>

      <section id="about" class="statement band" aria-labelledby="about-body">
        <div class="statement-inner">
          <h2 id="about-body" class="statement-label">
            Approach
          </h2>
          <div class="statement-body-wrap">
            <p class="statement-body">
              I care about the whole shape of a product: the model underneath, the interface on top,
              and the distance between a real operational problem and the screen that
              <em>solves it.</em>
            </p>
            <p class="statement-note">
              [Biography placeholder — to be written from verified facts. No employment history,
              dates, or claims may be added until confirmed.]
            </p>
          </div>
        </div>
      </section>

      {hasExperience ? (
        <section id="experience" class="work band" aria-labelledby="experience-title">
          <div class="section-rule">
            <h2 id="experience-title">Experience</h2>
            <p class="meta-note">{experiences.length} verified roles</p>
          </div>

          <div class="experience-grid">
            {experiences.map((experience) => (
              <article class="experience-card">
                <div class="experience-card-head">
                  <h3>{experience.data.role}</h3>
                  <p class="experience-period">
                    {experience.data.period.start} · {experience.data.period.end ?? '[to confirm]'}
                  </p>
                </div>
                <p class="experience-org">{experience.data.organization}</p>
                <p class="experience-summary">{experience.data.summary ?? '[to confirm]'}</p>
                <ul class="experience-list">
                  {experience.data.contributions.map((contribution) => (
                    <li>{contribution}</li>
                  ))}
                </ul>
                <p class="experience-tech">
                  <strong>Stack:</strong>{' '}
                  {experience.data.technologies.join(', ') ?? '[to confirm]'}
                </p>
              </article>
            ))}
          </div>
        </section>
      ) : (
        <section class="empty" aria-label="No experience">
          <p class="empty-body">
            No verified experience entries are available yet.
            <br />
            [Placeholder — add experience to `src/content/experience/` and set
            <code>contentStatus: verified</code>.]
          </p>
        </section>
      )}
    </main>

    <footer class="site-foot">
      <div class="foot-grid">
        <div>
          <p class="foot-label">Get in touch</p>
          <a class="foot-mail" href="mailto:hello@example.com">
            hello@example.com
          </a>
        </div>
        <ul class="foot-links">
          <li>
            <a
              href="https://linkedin.com/in/carlos-renato"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://github.com/carlos-renato" target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </li>
          <li>
            <a href="/cv.pdf">CV</a>
          </li>
        </ul>
      </div>
      <p class="colophon">Carlos Renato — direction C, 2026</p>
    </footer>

    <script>
      // Deterministic capture state for review screenshots.
      if (new URLSearchParams(location.search).has('static')) {
        document.documentElement.classList.add('no-motion');
      }
    </script>
  </body>
</html>
