---
// About and experience — profile, professional record and education.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import LocationPin from '@/components/LocationPin.astro';
import { getExperienceGroups, getProfile } from '@/lib/content';
import { profilePageNode } from '@/lib/seo';
import { ROUTES, SITE } from '@/config/site';

const profile = await getProfile();
const { primary, additional } = await getExperienceGroups();

const profileIsVerified = profile.data.contentStatus === 'verified';
const hasExperience = primary.length + additional.length > 0;
const education = profile.data.education;

// About previews the work history; the full chronology lives on /experience/.
const featuredRoles = primary.slice(0, 3);
const extraRoles = Math.max(0, primary.length - featuredRoles.length + additional.length);

const experienceMeta = hasExperience
  ? [profile.data.yearsExperience, `${primary.length + additional.length} roles`]
      .filter(Boolean)
      .join(' · ')
  : 'Nothing verified yet';

const description =
  'Profile, professional record and education of Carlos Renato, a senior software engineer in Nicaragua working on backend systems, APIs and enterprise integrations.';
---

<BaseLayout
  title={`About — ${SITE.name}, Senior Software Engineer`}
  description={description}
  path={ROUTES.about}
  current="about"
  schema={[profilePageNode()]}
>
  <section class="hero" aria-labelledby="about-title">
    <div class="hero-grid">
      <h1 id="about-title">About</h1>
      <p class="hero-lede">
        {profileIsVerified
          ? profile.data.shortIntro
          : 'A biography, the work behind it, and how I approach a product. The facts on this page are published only after they are verified.'}
      </p>
    </div>
  </section>

  <section class="work" aria-labelledby="profile-title">
    <div class="section-rule">
      <h2 id="profile-title">Profile</h2>
      <p>
        {profile.data.location ? (
          <span class="meta-location">
            <LocationPin />
            {profile.data.location}
          </span>
        ) : (
          '[location to confirm]'
        )}
        {profile.data.yearsExperience && ` · ${profile.data.yearsExperience}`}
      </p>
    </div>

    <div class="bio">
      {profileIsVerified ? (
        <>
          <p class="bio-headline">{profile.data.headline}</p>
          <p>{profile.data.biography}</p>
          <p class="section-note">
            <a class="text-link" href={ROUTES.skills}>
              The stack, layer by layer <span aria-hidden="true">→</span>
            </a>
          </p>
          {profile.data.availability && (
            <p class="badge">
              <span class="dot" aria-hidden="true" />
              {profile.data.availability}
            </p>
          )}
        </>
      ) : (
        <p class="placeholder">
          [Biography placeholder — to be written from verified facts. No employment history, dates,
          employers or claims are published until the owner confirms them.]
        </p>
      )}
    </div>
  </section>

  <section class="work" aria-labelledby="experience-title">
    <div class="section-rule">
      <h2 id="experience-title">Experience</h2>
      <p class="rule-meta">
        {experienceMeta}
        <a class="rule-link" href={ROUTES.experience}>
          Full record <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    {hasExperience ? (
      <>
        <div class="experience-grid">
          {featuredRoles.map((experience) => (
            <ExperienceCard experience={experience} />
          ))}
        </div>

        {extraRoles > 0 && (
          <p class="section-note">
            <a class="text-link" href={ROUTES.experience}>
              {extraRoles} earlier {extraRoles === 1 ? 'role' : 'roles'}, with the full detail{' '}
              <span aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </>
    ) : (
      <div class="empty">
        <p class="empty-body">
          Experience is published only from verified records: organization, role, dates and
          contributions. Nothing has been confirmed yet.
        </p>
        <p class="empty-note">
          [Content pending — verified entries go in <code>src/content/experience/</code>.]
        </p>
      </div>
    )}
  </section>

  <section class="work" aria-labelledby="education-title">
    <div class="section-rule">
      <h2 id="education-title">Education</h2>
      <p>
        {education.length === 0
          ? 'Nothing verified yet'
          : education.length === 1
            ? '1 degree'
            : `${education.length} degrees`}
      </p>
    </div>

    {education.length > 0 ? (
      <ul class="education-list">
        {education.map((entry) => (
          <li>
            <div>
              <h3>{entry.credential}</h3>
              <p class="education-org">
                {entry.institution}
                {entry.location && <span class="experience-location"> — {entry.location}</span>}
              </p>
            </div>
            <p class="experience-period">{entry.period}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="placeholder">[Education placeholder — institution, credential and years.]</p>
    )}
  </section>

  <section class="statement band" aria-labelledby="approach-title">
    <div class="statement-inner">
      <h2 id="approach-title" class="statement-label">
        Approach
      </h2>

      <div class="statement-body-wrap">
        <p class="statement-body">
          I care about the whole shape of a product: the model underneath, the interface on top, and
          the distance between a real operational problem and the screen that <em>solves it.</em>
        </p>
        <p class="statement-note">
          <span class="is-pending">
            [Working philosophy placeholder — to be written by the owner.]
          </span>
        </p>

        <div class="statement-links">
          <a class="text-link" href={ROUTES.projects}>
            See the work <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={ROUTES.contact}>
            Get in touch <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
