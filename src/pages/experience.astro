---
// Experience — the full professional record, newest first, plus education.
// Every line here comes from `src/content/experience/` (verified from the CV);
// nothing is summarised into a claim the CV does not make.
import BaseLayout from '@/layouts/BaseLayout.astro';
import LocationPin from '@/components/LocationPin.astro';
import { formatPeriod, getExperienceGroups, getProfile } from '@/lib/content';
import { ROUTES, SITE } from '@/config/site';

const profile = await getProfile();
const { primary, additional } = await getExperienceGroups();
const education = profile.data.education;
const total = primary.length + additional.length;

const description =
  'Professional record of Carlos Renato: backend and integration roles across logistics, marketing analytics and enterprise platforms, with the problems each one owned.';

const roleCount = total === 1 ? '1 role' : `${total} roles`;

/** A role entry from the experience collection, rendered in the timeline. */
const rows = [...primary, ...additional];
---

<BaseLayout
  title={`Experience — ${SITE.name}`}
  description={description}
  path={ROUTES.experience}
  current="experience"
>
  <section class="hero hero-page" aria-labelledby="experience-title">
    <div class="hero-grid">
      <p class="status">
        <span class="status-dot" aria-hidden="true" />
        {profile.data.availability ?? 'Available on request'}
      </p>

      <h1 id="experience-title">
        A decade of <br /> systems in <em>production.</em>
      </h1>

      <p class="hero-lede">
        Integration work, backend architecture and the operational software around it. The record
        below is the published CV, role by role; the projects section shows what came out of it.
      </p>

      <dl class="hero-meta">
        <div>
          <dt>Based in</dt>
          <dd>
            <span class="meta-location">
              <LocationPin />
              {profile.data.location ?? '[location to confirm]'}
            </span>
          </dd>
        </div>
        <div>
          <dt>Experience</dt>
          <dd>{profile.data.yearsExperience ?? '[years to confirm]'}</dd>
        </div>
        <div>
          <dt>Roles</dt>
          <dd>{roleCount}</dd>
        </div>
        <div>
          <dt>Current</dt>
          <dd>Founder, Nativerse</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="work" aria-labelledby="record-title">
    <div class="section-rule">
      <h2 id="record-title">Professional record</h2>
      <p>{roleCount}, newest first</p>
    </div>

    <ol class="timeline">
      {rows.map((entry) => (
        <li class="timeline-row">
          <div class="timeline-side">
            <p class="timeline-period">{formatPeriod(entry.data.period)}</p>
            {entry.data.location && <p class="timeline-where">{entry.data.location}</p>}
          </div>

          <div class="timeline-body">
            <p class="eyebrow">{entry.data.organization}</p>
            <h3 class="timeline-role">{entry.data.role}</h3>

            {entry.data.summary && <p class="timeline-summary">{entry.data.summary}</p>}

            {entry.data.contributions.length > 0 && (
              <ul class="timeline-list">
                {entry.data.contributions.map((contribution) => (
                  <li>{contribution}</li>
                ))}
              </ul>
            )}

            {entry.data.technologies.length > 0 && (
              <ul class="chip-row" aria-label={`Technologies at ${entry.data.organization}`}>
                {entry.data.technologies.map((technology) => (
                  <li class="chip">{technology}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work" aria-labelledby="education-title">
    <div class="section-rule">
      <h2 id="education-title">Education</h2>
      <p>{education.length === 1 ? '1 degree' : `${education.length} degrees`}</p>
    </div>

    <ul class="education-list">
      {education.map((entry) => (
        <li>
          <div>
            <h3>{entry.credential}</h3>
            <p class="education-org">
              {entry.institution}
              {entry.location && <span class="experience-location"> — {entry.location}</span>}
            </p>
          </div>
          <p class="experience-period">{entry.period}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="statement band" aria-labelledby="next-title">
    <div class="statement-inner">
      <h2 id="next-title" class="statement-label">
        Next
      </h2>

      <div class="statement-body-wrap">
        <p class="statement-body">
          The CV says what I was responsible for. The projects show what that looked like in
          practice — including where AI sits in the work and where it <em>stops.</em>
        </p>

        <div class="statement-links">
          <a class="text-link" href={ROUTES.projects}>
            Projects <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={ROUTES.ai}>
            AI &amp; automation <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={ROUTES.contact}>
            Get in touch <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
