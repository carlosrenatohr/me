---
// AI — what is built with it, what is used daily, and what it means for a team.
// Every claim here comes from the published CV (public/cv.pdf); nothing is added
// beyond the work already described there.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES, SITE } from '@/config/site';

const tools = ['Claude Code', 'Codex', 'OpenCode', 'Cursor', 'GitHub Copilot'];

const built = [
  {
    title: 'MCP servers for real services',
    body: 'Servers that connect AI clients to application capabilities and existing services, so an assistant can read and act on the same system a person uses. One of them is a production integration consumed by an internal fine-tuned model.',
  },
  {
    title: 'AI in client support',
    body: 'At BEON I built an early AI-driven support chatbot into a production system, when “AI feature” still meant a careful conversation about what the model should never be allowed to answer.',
  },
];

const skills = [
  {
    label: 'Languages & runtime',
    items: ['TypeScript', 'Node.js', 'Python', 'PHP', 'JavaScript', 'C#'],
  },
  {
    label: 'Backend & APIs',
    items: [
      'NestJS',
      'ExpressJS',
      'Laravel',
      'ASP.NET Core',
      'GraphQL',
      'REST',
      'Microservices',
      'OAuth 2.0',
      'JWT',
      'Webhooks',
    ],
  },
  {
    label: 'Data & analytics',
    items: [
      'PostgreSQL',
      'MySQL',
      'SQL Server',
      'MongoDB',
      'BigQuery',
      'Redis / Valkey',
      'Drizzle',
      'Entity Framework',
    ],
  },
  {
    label: 'Pipelines & messaging',
    items: ['BullMQ', 'RabbitMQ', 'Amazon SQS', 'Event-driven architecture', 'Webhook ingestion'],
  },
  {
    label: 'Cloud & infrastructure',
    items: ['AWS (EC2, RDS, SQS, ECS)', 'GCP', 'Cloudflare Workers', 'Docker', 'CI/CD'],
  },
  {
    label: 'Frontend & product',
    items: ['React', 'Astro', 'Next.js', 'Preact', 'TypeScript'],
  },
];

// The loop DREDD runs, in the order it runs it. The last step is the point:
// a review that cannot point at evidence is not a review.
const loop = [
  {
    title: 'The brief is the contract',
    body: 'Work starts from the requirement, not from the diff. Each agent receives the intent and the files it needs, so a change is measured against what it was supposed to do.',
  },
  {
    title: 'Parallel reviewers, separate concerns',
    body: 'Code and security reviews run as independent agents. Separating them keeps one loud finding from drowning the other, and makes each report reviewable on its own terms.',
  },
  {
    title: 'Automated checks decide the obvious',
    body: 'Build, types, tests and the security scan run before any opinion is offered. A finding that the compiler can make is not worth a paragraph.',
  },
  {
    title: 'Findings are reconciled, not concatenated',
    body: 'Duplicated and contradictory findings collapse into one item with its evidence attached. The output is a decision list, not four reports stapled together.',
  },
  {
    title: 'A person signs the result',
    body: 'The workflow can say “not verified”. It cannot say “merged”. Approval stays with the engineer, which is what keeps the speed from becoming a liability.',
  },
];

// Reading my own projects with a model: the part I actually trust it with.
const reading = [
  {
    title: 'Map the data before the change',
    body: 'I ask for the tables, the joins and the direction of every write, then check the answer against the schema. When the map is wrong, the model is confidently wrong, and the schema is where that shows.',
  },
  {
    title: 'Explain the failure path',
    body: 'Retries, partial writes, duplicate deliveries. A model is useful at enumerating failure modes I have stopped noticing in my own code, precisely because it has no memory of writing it.',
  },
  {
    title: 'Review the reasoning, keep the evidence',
    body: 'Every conclusion has to name the file, the query or the test that supports it. If it cannot, it is a hypothesis, and hypotheses go to the terminal before they go to a commit.',
  },
];

const process = [
  {
    title: 'Understand the system before changing it',
    body: 'Read the schema, trace the data path, and find where two sources disagree about the same fact. Most “bugs” in an integration are two definitions of the same word.',
    practice:
      'At GrowthOptix, reconciliation across advertising and payment platforms removed double counting before any dashboard was worth trusting.',
  },
  {
    title: 'Draw the boundary',
    body: 'Decide what is a service, what is a job, what is a table, and what should not exist at all. A smaller system with clear edges is cheaper to change than a large one with a shared middle.',
    practice:
      'Event-driven pipelines on BullMQ, RabbitMQ and Amazon SQS, feeding six attribution models across more than 300 organizations.',
  },
  {
    title: 'Build the integration, not the demo',
    body: 'OAuth flows, token lifecycle, retries, idempotency, backfills and the failure path nobody records in the ticket. The part that makes an integration survive its second month.',
    practice:
      'Four ad-platform integrations with token lifecycle management, sustaining about 96% success across 35K+ sync jobs, plus webhook ingestion for five providers.',
  },
  {
    title: 'Make it observable and affordable',
    body: 'A slow query is a product decision, not a database detail. Measure, reshape, and move the read path when the data belongs somewhere else.',
    practice:
      'Contact-profile reads went from about 18 s to about 1 ms by reshaping queries and moving the read path from MongoDB to BigQuery.',
  },
  {
    title: 'Review with evidence',
    body: 'AI makes changes cheap to produce and expensive to trust. Every change is reviewed like any other: tests, security checks, and a reason that points at the requirement it satisfies.',
    practice:
      'DREDD coordinates parallel code and security reviews, automated checks and evidence-based validation before delivery.',
  },
  {
    title: 'Leave it runnable by someone else',
    body: 'The work is not finished when it deploys. It is finished when the next engineer can change it without a call, and when the team agrees on how the next one gets built.',
    practice:
      'Led four developers at BEON across concurrent client projects, owning backend architecture and production reliability.',
  },
];

const description =
  'How Carlos Renato uses AI in production engineering: agentic code review, MCP servers, and the judgement that keeps the output verifiable.';
---

<BaseLayout
  title={`AI & engineering automation — ${SITE.name}`}
  description={description}
  path={ROUTES.ai}
  current="ai"
>
  <section class="hero" aria-labelledby="ai-title">
    <div class="hero-grid">
      <p class="status">
        <span class="status-dot" aria-hidden="true" />
        In daily use since 2023
      </p>

      <h1 id="ai-title">
        The AI is in <br /> the workflow.
      </h1>

      <p class="hero-lede">
        Not in a demo. I use AI-assisted development on real delivery — code review, integration
        work, and the parts of engineering that nobody should have to do twice — with human review
        and validation before anything ships.
      </p>
    </div>
  </section>

  <section class="work ai-feature" aria-labelledby="dredd-title">
    <div class="section-rule">
      <h2 id="dredd-title">DREDD</h2>
      <p>Personal system · in use for over a year</p>
    </div>

    <div class="ai-feature-body">
      <div class="ai-feature-lead">
        <h3 class="ai-feature-title">
          A review workflow that <em>cannot</em> declare itself right.
        </h3>

        <p>
          DREDD is how I review my own work and the work AI produces for me: parallel code and
          security reviews, automated checks, and a reconciliation pass that validates the result
          against the brief before anything is called done.
        </p>

        <p class="statement-note">
          I built it because the bottleneck was never writing code — it was reading it with enough
          attention. A review that runs the same way every time, and can show its evidence, is worth
          more than a faster reviewer having a better day.
        </p>
      </div>

      <ol class="loop">
        {loop.map((step, index) => (
          <li class="loop-step">
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="work" aria-labelledby="reading-title">
    <div class="section-rule">
      <h2 id="reading-title">How I read my own projects</h2>
      <p>Three habits, no autopilot</p>
    </div>

    <ol class="solution-list">
      {reading.map((item, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work" aria-labelledby="built-title">
    <div class="section-rule">
      <h2 id="built-title">Other systems</h2>
      <p>{built.length} systems</p>
    </div>

    <ol class="solution-list">
      {built.map((item, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work" aria-labelledby="use-title">
    <div class="section-rule">
      <h2 id="use-title">How I use it</h2>
      <p>{tools.length} tools, one rule</p>
    </div>

    <div class="ai-teaser-body">
      <p class="ai-teaser-lede">
        AI drafts, the review decides. A model proposes a change in seconds; the tests, the security
        pass and the reasoning behind it are still the engineer's job.
      </p>

      <div>
        <p class="statement-note">
          The same rule applies to my own work: the tools are set up, used and reviewed by me, and
          an answer I cannot explain does not count as an answer.
        </p>

        <ul class="chip-row">
          {tools.map((tool) => (
            <li class="chip">{tool}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="work" aria-labelledby="skills-title">
    <div class="section-rule">
      <h2 id="skills-title">Skills</h2>
      <p>The stack behind it</p>
    </div>

    <div class="skills-grid">
      {skills.map((group) => (
        <div class="skill-group">
          <h3>{group.label}</h3>
          <ul>
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="work" aria-labelledby="team-title">
    <div class="section-rule">
      <h2 id="team-title">What I would own on a team</h2>
      <p>Six stages, one loop</p>
    </div>

    <ol class="process-list">
      {process.map((step, index) => (
        <li class="process-step">
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <p class="step-practice">
              <strong>In practice</strong>
              {step.practice}
            </p>
          </div>
        </li>
      ))}
    </ol>

    <p class="ai-note">
      Everything on this page comes from the published CV and the work already described in it.
      Client engagements are named only where they are already public, and no outcome is inferred.
    </p>
  </section>

  <section class="statement band" aria-labelledby="ai-cta-title">
    <div class="statement-inner">
      <h2 id="ai-cta-title" class="statement-label">
        Work with me
      </h2>

      <div class="statement-body-wrap">
        <p class="statement-body">
          If your team is adding AI to a product, the hard part is rarely the model. It is the
          plumbing around it: the data it reads, the permission it respects, the review it still has
          to pass.
        </p>

        <div class="statement-links">
          <a class="text-link" href={ROUTES.projects}>
            See the work <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={ROUTES.contact}>
            Start a conversation <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
