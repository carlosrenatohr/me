---
// Home — direction C. Structure ported from design-lab/c-vibrant-editorial/index.html.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectAccordion from '@/components/ProjectAccordion.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import ProjectPair from '@/components/ProjectPair.astro';
import LocationPin from '@/components/LocationPin.astro';
import {
  formatPeriod,
  getDraftProjects,
  getExperience,
  getProfile,
  getProjectGroups,
  getPublishedProjects,
} from '@/lib/content';
import { ROUTES, SITE } from '@/config/site';

const profile = await getProfile();
const projects = await getPublishedProjects();
const { featured, openSource } = await getProjectGroups();
const drafts = await getDraftProjects();
const experience = await getExperience();

// The owner's hierarchy, not a popularity contest: the first featured product
// gets the wide block, the rest share the pair row.
const leadProduct = featured[0];
const otherProducts = featured.slice(1);

// The three most recent roles, from verified experience entries only.
const recentRoles = experience.slice(0, 3);

const profileIsVerified = profile.data.contentStatus === 'verified';

// Approved concept copy. Once the owner supplies a verified short intro, the
// lede reads from content instead.
const lede = profileIsVerified
  ? profile.data.shortIntro
  : 'I work close to the people who use a product: understanding how they work, figuring out what needs to change, and building the software with the team.';

const workCount = projects.length === 1 ? '1 project' : `${projects.length} projects`;
---

<BaseLayout title={SITE.defaultTitle} description={SITE.description} path={ROUTES.home}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-top">
        {profileIsVerified && profile.data.availability && (
          <p class="status">
            <span class="status-dot" aria-hidden="true" />
            {profile.data.availability}
          </p>
        )}

        {/* The headline is written as a statement, not a job title. This line
            carries the professional identity and place; the name lives in the
            wordmark, the title and the structured data. */}
        <p class="hero-role">Product Engineer · Managua, Nicaragua</p>
      </div>

      <h1 id="hero-title">
        I build software <br /> for real <em>problems.</em>
      </h1>

      <p class="hero-lede">{lede}</p>

      <dl class="hero-meta">
        <div>
          <dt>Working from</dt>
          <dd>
            {profile.data.location ? (
              <span class="meta-location">
                <LocationPin />
                {profile.data.location}
              </span>
            ) : (
              <span class="is-pending">[location to confirm]</span>
            )}
          </dd>
        </div>
        <div>
          <dt>Experience</dt>
          <dd>
            {profile.data.yearsExperience ?? <span class="is-pending">[years to confirm]</span>}
          </dd>
        </div>
        <div>
          <dt>Work</dt>
          <dd>{projects.length ? workCount : '[no published projects yet]'}</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd>
            <a href={ROUTES.contact}>Get in touch</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="work" id="projects" aria-labelledby="projects-title">
    <div class="section-rule">
      <h2 id="projects-title">Featured products</h2>
      <p class="rule-meta">
        {workCount}
        <a class="rule-link" href={ROUTES.projects}>
          All projects <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    {leadProduct ? (
      <ProjectFeature project={leadProduct} priority />
    ) : (
      <div class="empty">
        <p class="empty-body">
          No product has been published yet. Every case study is released only once its role, dates
          and outcomes are verified, so nothing here is guessed.
        </p>
      </div>
    )}

    <ProjectPair projects={otherProducts} />
  </section>

  {openSource.length + drafts.length > 0 && (
    <section class="work" id="experiments" aria-label="More work and open source">
      <ProjectAccordion projects={openSource} drafts={drafts} />
    </section>
  )}

  <section class="work" id="experience" aria-labelledby="experience-title">
    <div class="section-rule">
      <h2 id="experience-title">Experience</h2>
      <p class="rule-meta">
        {profile.data.yearsExperience ?? 'Professional record'}
        <a class="rule-link" href={ROUTES.experience}>
          Full record <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <ol class="record-list">
      {recentRoles.map((entry) => (
        <li class="record-row">
          <p class="record-period">{formatPeriod(entry.data.period)}</p>
          <div class="record-body">
            <p class="eyebrow">{entry.data.organization}</p>
            <h3>{entry.data.role}</h3>
            {entry.data.summary && <p class="record-summary">{entry.data.summary}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work ai-teaser" id="ai" aria-labelledby="ai-title">
    <div class="section-rule">
      <h2 id="ai-title">AI &amp; automation</h2>
      <p>In daily use since 2023</p>
    </div>

    <div class="ai-teaser-body">
      <p class="ai-teaser-lede">
        AI drafts, the review decides. I build the parts that make that safe: DREDD, a multi-agent
        review workflow, and MCP servers that connect models to the systems they act on.
      </p>

      <div>
        <p class="statement-note">
          Not a demo reel. A change still has to pass the tests, the security review and the reason
          it exists — which is the only way any of this is worth shipping.
        </p>

        <a class="text-link" href={ROUTES.ai}>
          How I work with AI <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="statement band" id="about" aria-labelledby="about-title">
    <div class="statement-inner">
      <h2 id="about-title" class="statement-label">
        Approach
      </h2>

      <div class="statement-body-wrap">
        <p class="statement-body">
          I care about the whole shape of a product: the model underneath, the interface on top, and
          the distance between a real operational problem and the screen that <em>solves it.</em>
        </p>

        <p class="statement-note">
          Most of my work is backend: APIs, integrations, data pipelines. I stay in the room from
          the first product decision through delivery, and I still support what ships.
        </p>

        <div class="statement-links">
          <a class="text-link" href={ROUTES.about}>
            More about my work <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={ROUTES.contact}>
            Start a conversation <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
